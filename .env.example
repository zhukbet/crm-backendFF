# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_crm?schema=public

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379

# --- Telegram ---
# Token from BotFather. Also used to verify Telegram Login Widget HMAC signature.
BOT_TOKEN=
# Secret string checked against Telegram's X-Telegram-Bot-Api-Secret-Token header on the webhook.
TELEGRAM_WEBHOOK_SECRET=change-me
# Public HTTPS URL Telegram will POST updates to, e.g. https://api.example.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# --- Auth ---
# Random long string used to sign session cookies/JWT.
JWT_SECRET=change-me
SESSION_COOKIE_NAME=support_crm_session
# Set to true only if frontend and backend are on genuinely different origins (e.g. a temporary
# ngrok/Cloudflare-tunnel dev setup). Leave false for the real prod topology (DEPLOY.md), where
# Caddy puts both behind one origin and SameSite=Lax is correct and preferable.
SESSION_COOKIE_CROSS_SITE=false
# How many minutes of client inactivity still count as "same thread" (section 4, rule 2).
THREAD_IDLE_WINDOW_MINUTES=180

# --- CORS ---
# Comma-separated origins allowed to call this API with credentials, e.g.
# https://app.example.com,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- Uploads ---
# This backend's own public origin — baked into uploaded-file URLs handed to Telegram's
# sendPhoto/sendDocument, which fetch the URL themselves. Defaults to http://localhost:$PORT.
PUBLIC_URL=
