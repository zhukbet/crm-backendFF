# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_crm?schema=public

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379

# --- Telegram ---
# Token from BotFather. Also used to verify Telegram Login Widget HMAC signature.
BOT_TOKEN=
# Secret string checked against Telegram's X-Telegram-Bot-Api-Secret-Token header on the webhook.
TELEGRAM_WEBHOOK_SECRET=change-me
# Public HTTPS URL Telegram will POST updates to, e.g. https://api.example.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# --- Auth ---
# Random long string used to sign session cookies/JWT.
JWT_SECRET=change-me
SESSION_COOKIE_NAME=support_crm_session
# How many minutes of client inactivity still count as "same thread" (section 4, rule 2).
THREAD_IDLE_WINDOW_MINUTES=180

# --- CORS ---
# Origin of the deployed frontend app, e.g. https://app.example.com
FRONTEND_ORIGIN=http://localhost:5173
